generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER // seeker looking for housing / a roommate
  PROVIDER // lists rooms/mess/apartments
  ADMIN
}

enum ListingStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum BookingStatus {
  PENDING_PAYMENT // booking hold created, awaiting payment
  CONFIRMED // payment succeeded
  CANCELLED // user cancelled or payment failed/expired
  COMPLETED
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentGateway {
  SSLCOMMERZ
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  listings Listing[] @relation("ProviderListings")
  bookings Booking[] @relation("CustomerBookings")

  @@index([role])
}

model Listing {
  id            String        @id @default(uuid())
  providerId    String
  provider      User          @relation("ProviderListings", fields: [providerId], references: [id], onDelete: Cascade)
  title         String
  description   String
  city          String
  address       String
  rentAmount    Decimal       @db.Decimal(10, 2)
  roomType      String // e.g. "single", "shared", "mess", "apartment"
  capacity      Int           @default(1)
  amenities     String[]      @default([])
  images        String[]      @default([])
  status        ListingStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  bookings Booking[]

  // Composite index accelerates the most common search: browse by city + status
  @@index([city, status])
  @@index([providerId])
}

model Booking {
  id           String        @id @default(uuid())
  listingId    String
  listing      Listing       @relation(fields: [listingId], references: [id], onDelete: Restrict)
  customerId   String
  customer     User          @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  startDate    DateTime
  endDate      DateTime
  totalAmount  Decimal       @db.Decimal(10, 2)
  status       BookingStatus @default(PENDING_PAYMENT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  payment Payment?

  @@index([listingId, status])
  @@index([customerId])
}

model Payment {
  id              String         @id @default(uuid())
  bookingId       String         @unique
  booking         Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount          Decimal        @db.Decimal(10, 2)
  currency        String         @default("BDT")
  gateway         PaymentGateway @default(SSLCOMMERZ)
  transactionId   String         @unique
  gatewaySessionKey String?
  status          PaymentStatus  @default(INITIATED)
  gatewayResponse Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([transactionId])
}
