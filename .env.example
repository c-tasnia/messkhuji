# --- Database (use a pooled connection string for serverless, e.g. Prisma Accelerate / pgbouncer / Neon pooled URL) ---
DATABASE_URL="postgresql://user:password@host:5432/messkhuji?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@host:5432/messkhuji"

# --- Auth ---
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS="12"

# --- Redis (Upstash REST - works on Vercel serverless functions) ---
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxx"

# --- SSLCommerz (mandatory payment gateway) ---
SSLCOMMERZ_STORE_ID="your_store_id"
SSLCOMMERZ_STORE_PASSWORD="your_store_password"
SSLCOMMERZ_IS_LIVE="false"

# --- App URLs (used to build SSLCommerz success/fail/cancel/IPN callback URLs) ---
APP_BASE_URL="https://messkhuji.vercel.app"
FRONTEND_BASE_URL="https://messkhuji-frontend.vercel.app"

# --- Misc ---
NODE_ENV="production"
PORT="4000"
CORS_ORIGINS="https://messkhuji-frontend.vercel.app,http://localhost:3000"
